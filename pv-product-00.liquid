{% schema %}
{
  "name": "PV Product 00",
  "tag": "div",
  "class": "pv-section",
  "settings": [
    { "type": "paragraph", "content": "Product copy, badges, ingredients, benefits and FAQs come from the built-in PowderVitamin product data. Blocks added here replace that list on this template." },
    { "type": "text", "id": "servings_label", "label": "Servings badge", "info": "Replaces the servings badge (e.g. 100 Servings). Empty keeps the product data's badge." },
    { "type": "select", "id": "copy_source", "label": "Title and description", "default": "auto", "options": [
      { "value": "auto", "label": "Auto (Shopify product if size has no data)" },
      { "value": "shopify", "label": "Always the Shopify product" },
      { "value": "database", "label": "Always the product data" }
    ] },
    { "type": "range", "id": "subscription_discount", "label": "Subscribe & save discount", "min": 0, "max": 40, "step": 1, "unit": "%", "default": 15 }
  ],
  "blocks": [
    { "type": "badge", "name": "Badge", "settings": [ { "type": "text", "id": "text", "label": "Badge text" } ] },
    { "type": "include", "name": "Formula item", "settings": [ { "type": "text", "id": "text", "label": "Text", "info": "e.g. 1,000mg Potassium Citrate" } ] },
    { "type": "benefit", "name": "Benefit", "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "local_shipping", "info": "A Material Symbols icon name, e.g. local_shipping, payments, biotech, flag, nutrition." },
      { "type": "text", "id": "label", "label": "Heading" },
      { "type": "text", "id": "sub", "label": "Text" }
    ] },
    { "type": "accordion", "name": "Details tab", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "richtext", "id": "content", "label": "Content" },
      { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
    ] },
    { "type": "faq", "name": "FAQ", "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "textarea", "id": "answer", "label": "Answer" }
    ] }
  ]
}
{% endschema %}
