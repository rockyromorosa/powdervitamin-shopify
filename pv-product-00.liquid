{%- comment -%} Ported from powdervitamin.com (WordPress/Elementor). {%- endcomment -%}
{%- comment -%} First paint renders the Shopify product (no "Loading..." placeholders); the page script refines it after. {%- endcomment -%}
{%- liquid
  assign pv_first_variant = product.selected_or_first_available_variant
  assign pv_atc_state = 'instock'
  assign pv_atc_label = 'ADD TO CART'
  assign pv_atc_bg = 'var(--pv-primary)'
  assign pv_atc_fg = '#000000'
  if pv_first_variant.available == false
    assign pv_atc_state = 'notify'
    assign pv_atc_label = 'NOTIFY ME WHEN IN STOCK'
  elsif pv_first_variant.inventory_management == 'shopify' and pv_first_variant.inventory_quantity <= 0
    assign pv_atc_state = 'preorder'
    assign pv_atc_label = 'PREORDER NOW'
  endif
-%}
<div class="pv-scope">
<script>
  window.PV_PATH = '/products/' + PV.wooSlugFor({{ product.title | json }}, {{ product.handle | json }}, {{ product.selected_or_first_available_variant.title | json }}) + '/';
</script>

					
