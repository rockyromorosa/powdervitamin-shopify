	<style>
		/* CSS Nuclear Shield for WordPress - RESTORED, CORRECTED & OPTIMIZED FOR WP ROCKET */
		#pv-bundle-detail-root {
			display: block !important;
			box-sizing: border-box !important;
			background-color: #ffffff !important;
			background-image:
				radial-gradient(at 0% 0%, rgba(var(--pv-primary-rgb), 0.12) 0px, transparent 50%),
				radial-gradient(at 100% 0%, rgba(var(--pv-primary-rgb), 0.08) 0px, transparent 50%) !important;
			/* Fade-in Safeguard: Immediate fallback to prevent invisibility under WP Rocket JS delay */
			opacity: 1 !important;
			transition: opacity 0.5s ease-in-out;
		}

		html.dark #pv-bundle-detail-root {
			background-color: #0a0f0b !important;
			background-image:
				radial-gradient(at 0% 0%, rgba(var(--pv-primary-rgb), 0.2) 0px, transparent 50%),
				radial-gradient(at 100% 100%, rgba(var(--pv-primary-rgb), 0.1) 0px, transparent 50%) !important;
			color: #f1f5f9 !important;
		}

		/* Class added by JS once loading is done */
		#pv-bundle-detail-root.content-ready {
			opacity: 1 !important;
		}

		#pv-bundle-detail-root * {
			box-sizing: border-box !important;
		}

		/* Heading Logic - Correct Weights for Titles Only */
		#pv-bundle-detail-root h2,
		#pv-bundle-detail-root h3,
		#pv-bundle-detail-root .font-bebas {
			font-family: var(--pv-font-heading) !important;
			font-weight: 400 !important;
			text-transform: uppercase !important;
			margin: 0 !important;
		}

		/* Description Cards & Accordion Headings Protection - Forces Inter Font */
		#pv-bundle-detail-root p,
		#pv-bundle-detail-root label,
		#pv-bundle-detail-root li,
		#pv-bundle-detail-root h4,
		#pv-bundle-detail-root h5,
		#pv-bundle-detail-root h6,
		#pv-bundle-detail-root #bundle-accordions h1,
		#pv-bundle-detail-root #bundle-accordions h2,
		#pv-bundle-detail-root #bundle-accordions h3,
		#pv-bundle-detail-root #bundle-accordions h4,
		#pv-bundle-detail-root #bundle-accordions h5,
		#pv-bundle-detail-root #bundle-accordions h6,
		#pv-bundle-detail-root #bundle-accordions summary span:not(.material-symbols-outlined),
		#pv-bundle-detail-root .hero-hook-box-target h4,
		#pv-bundle-detail-root .bundle-highlights-target h4 {
			font-family: var(--pv-font-body) !important;
		}

		#pv-bundle-detail-root p,
		#pv-bundle-detail-root label,
		#pv-bundle-detail-root li {
			font-weight: 500 !important;
		}

		#pv-bundle-detail-root span:not(.material-symbols-outlined) {
			font-family: var(--pv-font-body) !important;
		}

		/* Material Symbols Font Protection & Ligature Safeguard */
		#pv-bundle-detail-root .material-symbols-outlined,
		#pv-bundle-detail-root span.material-symbols-outlined,
		#pv-bundle-detail-root summary .material-symbols-outlined,
		#pv-bundle-detail-root details summary .material-symbols-outlined {
			font-family: 'Material Symbols Outlined' !important;
			display: flex !important;
			align-items: center !important;
			justify-content: center !important;
			text-transform: none !important;
		}

		/* Global Color Safeguard for Light Mode (Forces visibility of Slate-800 text) */
		html:not(.dark) #pv-bundle-detail-root {
			color: #0f172a !important;
		}

		html:not(.dark) #pv-bundle-detail-root p,
		html:not(.dark) #pv-bundle-detail-root li,
		html:not(.dark) #pv-bundle-detail-root label,
		html:not(.dark) #pv-bundle-detail-root span:not(.text-primary):not(.material-symbols-outlined) {
			color: #1e293b !important;
		}

		html:not(.dark) #breadcrumb-title {
			color: #0f172a !important;
			font-weight: 700 !important;
		}

		/* Text Colors for Dark Mode */
		html.dark #pv-bundle-detail-root p,
		html.dark #pv-bundle-detail-root span:not(.text-primary):not(.material-symbols-outlined),
		html.dark #pv-bundle-detail-root h2,
		html.dark #pv-bundle-detail-root h3,
		html.dark #pv-bundle-detail-root li {
			color: #f1f5f9 !important;
		}

		/* Explicit Weight Classes */
		#pv-bundle-detail-root .font-black {
			font-weight: 900 !important;
		}

		#pv-bundle-detail-root .font-bold {
			font-weight: 700 !important;
		}

		/* Centering Material Icons */
		#pv-bundle-detail-root .material-symbols-outlined {
			display: flex !important;
			align-items: center !important;
			justify-content: center !important;
			font-family: 'Material Symbols Outlined' !important;
		}

		/* Radio Fix - Vertically Centered & Flex Uncompressed */
		#pv-bundle-detail-root input[type="radio"] {
			appearance: none !important;
			-webkit-appearance: none !important;
			width: 18px !important;
			height: 18px !important;
			min-width: 18px !important;
			min-height: 18px !important;
			border: 2px solid var(--pv-primary) !important;
			border-radius: 50% !important;
			background: transparent !important;
			position: relative !important;
			cursor: pointer !important;
			outline: none !important;
			margin: 0 !important;
			flex-shrink: 0 !important;
			align-self: center !important;
		}

		/* Radio Container Alignment Helper */
		#pv-bundle-detail-root #selector-sub,
		#pv-bundle-detail-root #selector-ot {
			display: flex !important;
			align-items: center !important;
		}

		#pv-bundle-detail-root input[type="radio"]:checked {
			background-color: var(--pv-primary) !important;
			box-shadow: inset 0 0 0 3px #ffffff !important;
		}

		html.dark #pv-bundle-detail-root input[type="radio"]:checked {
			box-shadow: inset 0 0 0 3px #0a0f0b !important;
		}

		/* UI Helpers */
		.glass-card {
			background: rgba(255, 255, 255, 0.7) !important;
			backdrop-filter: blur(12px) !important;
			border: 1px solid rgba(var(--pv-primary-rgb), 0.2) !important;
		}

		html.dark .glass-card {
			background: rgba(0, 0, 0, 0.4) !important;
			border: 1px solid rgba(var(--pv-primary-rgb), 0.1) !important;
		}

		.amazon-badge {
			background: #FF9900 !important;
			color: white !important;
			padding: 2px 6px !important;
			border-radius: 4px !important;
			font-size: 10px !important;
			font-weight: bold !important;
		}

		.no-scrollbar::-webkit-scrollbar {
			display: none !important;
		}

		.no-scrollbar {
			-ms-overflow-style: none !important;
			scrollbar-width: none !important;
		}

		body#pv-bundle-detail-root {
			background-color: #ffffff !important;
			background-image:
				radial-gradient(at 0% 0%, rgba(var(--pv-primary-rgb), 0.12) 0px, transparent 50%),
				radial-gradient(at 100% 0%, rgba(var(--pv-primary-rgb), 0.08) 0px, transparent 50%) !important;
		}

		/* Forces CTA text and price to remain black even in dark mode */
		#pv-bundle-detail-root #atc-main,
		#pv-bundle-detail-root #atc-main span,
		html.dark #pv-bundle-detail-root #atc-main,
		html.dark #pv-bundle-detail-root #atc-main span {
			color: #000000 !important;
		}

		/* Forces Material Symbol stars to be filled and green */
		#pv-bundle-detail-root .material-symbols-outlined.fill-current,
		#pv-bundle-detail-root .text-primary .material-symbols-outlined {
			font-variation-settings: 'FILL' 1, 'wght' 700, 'GRAD' 0, 'opsz' 24 !important;
			color: var(--pv-primary) !important;
			/* Brand Green */
		}

		/* Ensure green color persists in dark mode */
		html.dark #pv-bundle-detail-root .material-symbols-outlined.fill-current,
		html.dark #pv-bundle-detail-root .text-primary .material-symbols-outlined {
			color: var(--pv-primary) !important;
		}

		/* Ensure the zoom container doesn't block other UI elements */
		.zoomContainer {
			z-index: 20005 !important;
			pointer-events: none;
			/* Allows clicks to go through to arrows if needed */
		}

		/* Unified Lightbox Layout Fixes */
		#review-lightbox {
			z-index: 20000 !important;
		}

		#review-lightbox-media-container {
			background: #000;
			display: flex;
			align-items: center;
			justify-content: center;
			min-height: 300px;
		}

		#lightbox-video-player {
			width: 100%;
			max-height: 70vh;
			outline: none;
		}

		#main-product-img:not(.zoom-active) {
			cursor: zoom-in !important;
		}

		/* Re-enable pointer events for the specific active zoom area */
		.zoomContainer .zoomWindowContainer {
			pointer-events: all;
		}

		/* Zoom Toggle Button Hidden */
		#zoom-toggle-btn {
			display: none !important;
		}

		/* Force Default Cursor when zoom is off */
		#main-product-img {
			cursor: default !important;
		}

		/* Force initial chip styles to bypass WordPress defaults */
		#pv-bundle-detail-root .flavor-chip,
		#pv-bundle-detail-root .size-chip {
			border: 1px solid rgba(var(--pv-primary-rgb), 0.2) !important;
			background-color: transparent !important;
			color: #64748b !important;
			/* Force gray text */
		}

		/* Force the "Selected" state for the default items and dynamic state changes */
		#pv-bundle-detail-root .flavor-chip.border-2,
		#pv-bundle-detail-root .flavor-chip.active-selection,
		#pv-bundle-detail-root .size-chip.border-2,
		#pv-bundle-detail-root .size-chip.active-selection {
			border: 2px solid var(--pv-primary) !important;
			background-color: rgba(var(--pv-primary-rgb), 0.05) !important;
		}

		#pv-bundle-detail-root .flavor-chip.border-2 span,
		#pv-bundle-detail-root .flavor-chip.active-selection span,
		#pv-bundle-detail-root .size-chip.border-2,
		#pv-bundle-detail-root .size-chip.active-selection {
			color: #0f172a !important;
			/* Dark text */
			font-weight: 900 !important;
		}

		html.dark #pv-bundle-detail-root .flavor-chip.border-2 span,
		html.dark #pv-bundle-detail-root .flavor-chip.active-selection span,
		html.dark #pv-bundle-detail-root .size-chip.border-2,
		html.dark #pv-bundle-detail-root .size-chip.active-selection {
			color: #ffffff !important;
			/* White text in dark mode */
		}

		/* FALLBACK TWO-COLUMN GRID LAYOUT (Ensures 2 columns on desktop before Tailwind loads) */
		@media (min-width: 1024px) {
			#pv-bundle-detail-root .grid.grid-cols-1.lg\:grid-cols-12 {
				display: grid !important;
				grid-template-columns: repeat(12, minmax(0, 1fr)) !important;
				gap: 3rem !important;
			}

			#pv-bundle-detail-root .lg\:col-span-7 {
				grid-column: span 7 / span 7 !important;
			}

			#pv-bundle-detail-root .lg\:col-span-5 {
				grid-column: span 5 / span 5 !important;
			}
		}

		/* FAQ visibility fallback insurance */
		#faq-container details {
			display: block !important;
			width: 100% !important;
			visibility: visible !important;
			opacity: 1 !important;
		}

		/* Loading Skeleton Masking Layer Animation */
		.skeleton-loading {
			position: relative;
			color: transparent !important;
			background-color: #e2e8f0 !important;
			border-color: #e2e8f0 !important;
			border-radius: 0.375rem !important;
			overflow: hidden !important;
			pointer-events: none !important;
		}

		html.dark .skeleton-loading {
			background-color: #1e293b !important;
			border-color: #1e293b !important;
		}

		.skeleton-loading::after {
			position: absolute;
			top: 0;
			right: 0;
			bottom: 0;
			left: 0;
			transform: translateX(-100%);
			background-image: linear-gradient(90deg,
					rgba(255, 255, 255, 0) 0%,
					rgba(255, 255, 255, 0.2) 20%,
					rgba(255, 255, 255, 0.6) 60%,
					rgba(255, 255, 255, 0) 100%);
			animation: skeleton-shimmer 2s infinite;
			content: '';
		}

		html.dark .skeleton-loading::after {
			background-image: linear-gradient(90deg,
					rgba(255, 255, 255, 0) 0%,
					rgba(255, 255, 255, 0.05) 20%,
					rgba(255, 255, 255, 0.1) 60%,
					rgba(255, 255, 255, 0) 100%);
		}

		@keyframes skeleton-shimmer {
			100% {
				transform: translateX(100%);
			}
		}
		/* Sold-out flavor + size chips: greyed out but still clickable (they open the product page, which shows OUT OF STOCK).
		   Non-existent combinations (.pv-chip-disabled) are inert: clicks are blocked in pv-product-00-1.js. */
		.flavor-chip.pv-chip-disabled,
		.size-chip.pv-chip-disabled,
		.flavor-chip.pv-chip-soldout,
		.size-chip.pv-chip-soldout {
			opacity: 0.4 !important;
			filter: grayscale(1) !important;
			cursor: not-allowed !important;
			border-style: dashed !important;
			border-color: rgba(100, 116, 139, 0.45) !important;
			background-color: transparent !important;
			text-decoration: line-through !important;
		}
		.flavor-chip.pv-chip-soldout,
		.size-chip.pv-chip-soldout { cursor: pointer !important; }
		.flavor-chip.pv-chip-soldout:hover,
		.size-chip.pv-chip-soldout:hover { opacity: 0.65 !important; }
		.pv-chips-pending .flavor-chip,
		.pv-chips-pending .size-chip { pointer-events: none; }
	</style>




	{%- comment -%} The fixed pv-navbar (h-20 + 1px border) floats over the page and #MainContent has no offset on pv-templates, so clear it here. {%- endcomment -%}
	<div aria-hidden="true" style="height: calc(5rem + 1px);"></div>

	<main class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-3 sm:py-6">
		<!-- Breadcrumbs -->
		<nav class="flex items-center gap-1 mb-2 sm:mb-3 text-[11px] sm:text-sm font-medium text-slate-500 dark:text-slate-400 overflow-x-auto no-scrollbar">
			<a class="hover:text-primary transition-colors whitespace-nowrap" href="/pages/shop-all" style="text-decoration:none !important; color: inherit !important;">Shop All</a>
			<span class="material-symbols-outlined text-[10px] sm:text-xs flex-shrink-0">chevron_right</span>
			<a class="hover:text-primary transition-colors whitespace-nowrap" href="/pages/prehydrate-electrolytes" style="text-decoration:none !important; color: inherit !important;">Electrolytes Powder Plus™</a>
			<span class="material-symbols-outlined text-[10px] sm:text-xs flex-shrink-0">chevron_right</span>
			<span class="text-slate-900 dark:text-slate-100 font-bold whitespace-nowrap" id="breadcrumb-title">{{ product.title }}</span>
		</nav>

		<!-- Header & Hero Hook Above Image (VISIBLE ON MOBILE ONLY) -->
		<div class="block lg:hidden space-y-2 sm:space-y-3 mb-3 sm:mb-5 max-w-4xl">
			<!-- Product Title -->
			<h2 class="font-bebas text-2xl sm:text-4xl font-normal tracking-tight leading-tight sm:leading-none uppercase text-slate-900 dark:text-white bundle-title-target">{{ product.title }}</h2>
			
			<!-- Ratings & Price Bar -->
			<div class="flex flex-wrap items-center gap-2.5 sm:gap-4">
				<!-- Ratings -->
				<div class="flex items-center gap-1.5 sm:gap-2">
					<div class="flex text-primary">
						<span class="material-symbols-outlined fill-current text-xs sm:text-base icon-green-forced">star</span>
						<span class="material-symbols-outlined fill-current text-xs sm:text-base icon-green-forced">star</span>
						<span class="material-symbols-outlined fill-current text-xs sm:text-base icon-green-forced">star</span>
						<span class="material-symbols-outlined fill-current text-xs sm:text-base icon-green-forced">star</span>
						<span class="material-symbols-outlined fill-current text-xs sm:text-base icon-green-forced">star_half</span>
					</div>
					<span id="review-count-text-mobile" class="text-[11px] sm:text-sm font-semibold text-slate-600 dark:text-slate-300 underline decoration-primary/40 underline-offset-2 sm:underline-offset-4 cursor-pointer hover:text-primary transition-colors"></span>
				</div>

				<!-- Price Display -->
				<div class="flex items-center gap-2 sm:gap-2.5">
					<span class="text-xl sm:text-3xl font-black text-slate-900 dark:text-white display-price-target" style="font-weight:900 !important;">{{ pv_first_variant.price | money }}</span>
					<span class="text-xs sm:text-lg text-slate-400 line-through strike-price-target"></span>
					<span class="bg-primary/20 text-slate-900 dark:text-primary px-2 py-0.5 rounded-md text-[10px] sm:text-[11px] font-black uppercase tracking-wider border border-primary/30 save-badge-target" style="font-weight:900 !important;"></span>
				</div>
			</div>

			<!-- "Why Thirsty Is Too Late" Hero Hook Box -->
			<div class="p-2.5 sm:p-3.5 rounded-lg sm:rounded-xl bg-gradient-to-br from-primary/15 via-primary/5 to-transparent border border-primary/25 shadow-sm relative overflow-hidden hero-hook-box-target">
				<div class="flex items-start gap-2 sm:gap-2.5">
					<span class="flex-shrink-0 w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-primary/20 green-text-badge text-[10px] sm:text-xs font-black flex items-center justify-center border border-primary/40 shadow-sm mt-0.5" style="color: var(--pv-primary) !important; font-weight:900 !important;">01</span>
					<div>
						<h4 class="font-black text-[11px] sm:text-sm text-slate-900 dark:text-white uppercase tracking-wide mb-0.5 sm:mb-1" style="font-weight:900 !important;">Why Thirsty Is Too Late</h4>
						<p class="text-[11px] sm:text-xs text-slate-700 dark:text-slate-300 leading-relaxed font-medium">
							Waiting until you feel thirsty means your body is already running at a deficit. Real energy and focus come from building your mineral baseline before demand begins. Every scoop of <strong class="text-slate-900 dark:text-white font-bold" style="font-weight:800 !important;">PREHYDRATE™</strong> delivers clean proactive preparation rich in potassium, essential magnesium, calcium, and Pink Himalayan salt.
						</p>
					</div>
				</div>
			</div>
		</div>

		<!-- Main 2-Column Responsive Grid -->
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-6 items-start">
			
			<!-- Left Column: Photo, Thumbnails & Desktop Benefit Icons -->
